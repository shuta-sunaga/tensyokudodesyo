<mt:Ignore>
============================================================
都道府県別ページテンプレート（デザイン v2 / 2026-09）
出力ファイル: {prefecture_id}/index.html
テンプレート種類: 各子ブログの「トップページ」インデックステンプレート

各子ブログでは先頭の <mt:SetVar> 2 行だけを差し替える（それ以外は全ブログ共通）。
scripts/redesign-v2/mt-apply-v2.pl が 47 ブログに一括反映する。
ローカル確認用の shiga/index.html 等は scripts/redesign-v2/build-static-from-mtml.mjs で生成する。
============================================================
</mt:Ignore>

<mt:SetVar name="prefecture_id" value="shiga">
<mt:SetVar name="prefecture_name" value="滋賀県">

<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="<mt:Var name="prefecture_name">の転職・求人情報。製造・技術・現場の仕事を中心に、<mt:Var name="prefecture_name">内の正社員求人を職種・市区町村・こだわり条件で検索できます。無料の面談で相談できる地域密着の転職支援です。">
    <title><mt:Var name="prefecture_name">の転職・求人情報 | 製造業・技術職に強い | 転職どうでしょう</title>

    <!-- Canonical -->
    <link rel="canonical" href="<mt:BlogURL><mt:Var name="prefecture_id">/">

    <!-- OGP -->
    <meta property="og:title" content="<mt:Var name="prefecture_name">の転職・求人情報 | 転職どうでしょう">
    <meta property="og:description" content="<mt:Var name="prefecture_name">の転職・求人情報を多数掲載。製造・技術・現場の正社員求人を検索。">
    <meta property="og:type" content="website">
    <meta property="og:url" content="<mt:BlogURL><mt:Var name="prefecture_id">/">
    <meta property="og:image" content="<mt:BlogURL>assets/ogp.png">
    <meta property="og:site_name" content="転職どうでしょう">
    <meta property="og:locale" content="ja_JP">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<mt:Var name="prefecture_name">の転職・求人情報 | 転職どうでしょう">
    <meta name="twitter:description" content="<mt:Var name="prefecture_name">の転職・求人情報を多数掲載。製造・技術・現場の正社員求人を検索。">
    <meta name="twitter:image" content="<mt:BlogURL>assets/ogp.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600&family=Noto+Sans+JP:wght@400;500;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css?v=20260915">
    <link rel="preload" href="/data/jobs/<mt:Var name="prefecture_id">.json" as="fetch" crossorigin>

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">

    <script>
        // Prefecture configuration for this page
        window.PREFECTURE_CONFIG = {
            id: '<mt:Var name="prefecture_id">',
            name: '<mt:Var name="prefecture_name">'
        };
    </script>

    <mt:Include module="ga-tag" global="1">

    <!-- JSON-LD: BreadcrumbList -->
    <script type="application/ld+json">
    {
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
            {
                "@type": "ListItem",
                "position": 1,
                "name": "ホーム",
                "item": "<mt:BlogURL>"
            },
            {
                "@type": "ListItem",
                "position": 2,
                "name": "<mt:Var name="prefecture_name">の求人"
            }
        ]
    }
    </script>
</head>
<body>
    <!-- Header (loaded via includes.js) -->
    <div id="header-placeholder"></div>

    <!-- Page header (navy band) -->
    <section class="page-header pref-header" data-en="<mt:Var name="prefecture_id" upper_case="1">">
        <div class="container">
            <nav class="breadcrumb">
                <a href="/">ホーム</a>
                <span><mt:Var name="prefecture_name">の求人</span>
            </nav>
            <div class="ph-grid">
                <div class="ph-title">
                    <span class="section-label">Jobs in <mt:Var name="prefecture_id" capitalize="1"></span>
                    <h1 class="page-title"><mt:Var name="prefecture_name">の求人</h1>
                </div>
                <div class="ph-lead">
                    <p>掲載中の求人 <b id="resultsCountTop">—</b> 件</p>
                    <p>製造・技術・現場の仕事を中心に、<mt:Var name="prefecture_name">の正社員求人を掲載しています。職種・市区町村・こだわり条件で絞り込めます。</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Search -->
    <section class="jobs-search" id="jobs">
        <div class="container">
            <mt:If name="prefecture_name" eq="福岡県">
            <aside class="prefecture-sponsor" aria-label="スポンサー" style="margin-bottom:20px;">
                <a href="https://kyushucarina.com/" target="_blank" rel="noopener" class="prefecture-sponsor__logo">
                    <img src="/assets/sponsor-carina.webp" alt="九州カリーナ" width="440" height="405" loading="lazy">
                </a>
                <div class="prefecture-sponsor__body">
                    <span class="prefecture-sponsor__label">SUPPORTER</span>
                    <p class="prefecture-sponsor__heading"><a href="https://kyushucarina.com/" target="_blank" rel="noopener">福岡を盛り上げる九州カリーナへ</a></p>
                    <p class="prefecture-sponsor__lead">地域とともに歩むチームの活動を、地元密着の転職支援で応援しています。</p>
                </div>
            </aside>
            </mt:If>
            <form class="jsr-panel" id="jobSearchForm" role="search" aria-label="求人の絞り込み">
                <input type="hidden" name="prefecture" id="prefectureFilter" value="<mt:Var name="prefecture_name">">
                <div class="jsr-row">
                    <div class="jsr-field">
                        <label for="searchKeyword">キーワード</label>
                        <div class="jsr-input-wrap">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                            <input type="text" name="q" id="searchKeyword" placeholder="職種名、会社名、資格、勤務地など" autocomplete="off">
                        </div>
                    </div>
                    <div class="jsr-field">
                        <label for="searchCity">市区町村</label>
                        <select name="city" id="searchCity"><option value="">すべて</option></select>
                    </div>
                    <div class="jsr-field">
                        <label for="searchJobType">職種</label>
                        <select name="cat" id="searchJobType"><option value="">すべて</option></select>
                    </div>
                    <div class="jsr-field">
                        <label for="searchEmp">雇用形態</label>
                        <select name="emp" id="searchEmp"><option value="">すべて</option></select>
                    </div>
                    <button type="submit" class="btn btn-primary jsr-submit">絞り込む</button>
                </div>
                <div class="jsr-chips-wrap" id="searchTags" aria-label="こだわり条件">
                    <span class="jsr-chips-label">こだわり条件</span>
                </div>
            </form>
        </div>
    </section>

    <!-- Job Results -->
    <section class="jobs-results">
        <div class="container">
            <div class="jsr-bar">
                <p class="jsr-count"><b id="resultsCount">0</b>件の求人<small id="resultsNote" style="color:var(--color-gray-light);font-size:.76rem"></small></p>
                <div class="jsr-active" id="activeFilters" aria-live="polite"></div>
                <div class="jsr-sort">
                    <label for="searchSort">並び順</label>
                    <select id="searchSort">
                        <option value="new">新着順</option>
                        <option value="salaryHigh">年収が高い順</option>
                        <option value="salaryLow">年収が低い順</option>
                    </select>
                </div>
            </div>
            <div id="jobListContainer" class="job-rows" aria-live="polite">
                <p class="jsr-loading">求人情報を読み込んでいます…</p>
            </div>
            <nav id="paginationContainer" class="pagination" aria-label="ページネーション"></nav>
        </div>
    </section>

    <!-- Interviews Section -->
    <section class="interview-section" id="interviews">
        <div class="container">
            <div class="section-header" data-en="Interview">
                <h2 class="section-title">転職者インタビュー</h2>
                <p class="section-subtitle"><mt:Var name="prefecture_name">で転職した方々の声</p>
            </div>
            <div id="interviewsContainer" class="article-grid">
                <div class="loading-placeholder" style="grid-column: 1 / -1; text-align: center; padding: 2rem; color: #666;">
                    インタビュー記事を読み込み中...
                </div>
            </div>
        </div>
    </section>

    <!-- Companies Section -->
    <section class="company-section" id="companies">
        <div class="container">
            <div class="section-header" data-en="Company">
                <h2 class="section-title">企業インタビュー</h2>
                <p class="section-subtitle"><mt:Var name="prefecture_name">の企業の、職場のリアル</p>
            </div>
            <div id="companiesContainer" class="article-grid">
                <div class="loading-placeholder" style="grid-column: 1 / -1; text-align: center; padding: 2rem; color: #666;">
                    企業情報を読み込み中...
                </div>
            </div>
        </div>
    </section>

    <!-- Contact CTA -->
    <section class="contact-cta">
        <div class="container">
            <div class="contact-cta-content">
                <div class="contact-cta-icon" aria-hidden="true">
                    <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
                    </svg>
                </div>
                <div class="contact-cta-text">
                    <h2 class="contact-cta-title"><mt:Var name="prefecture_name">の転職、まずはご相談から。</h2>
                    <p class="contact-cta-description">
                        在職中の情報収集から、本格的な転職活動まで。<br>
                        あなたのペースで、地域に詳しいキャリアアドバイザーがご案内します。
                    </p>
                </div>
                <div class="contact-cta-action">
                    <a href="/contact/" class="btn btn-primary btn-lg">転職相談はこちら</a>
                    <p class="contact-cta-note">※ご相談・面談はすべて無料です</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Footer (loaded via includes.js) -->
    <div id="footer-placeholder"></div>

    <script src="/js/data-cache.js?v=20260915"></script>
    <script src="/js/includes.js?v=20260915"></script>
    <script src="/js/categories.js?v=20260915"></script>
    <script src="/js/job-taxonomy.js?v=20260915b"></script>
    <script src="/js/main.js?v=20260915"></script>
    <script src="/js/prefecture-page.js?v=20260915b"></script>
</body>
</html>
